# Copy this file to .streamlit/secrets.toml and fill in real values for a
# deployed instance (Streamlit Community Cloud reads this from its Secrets
# panel, not from this file). For local development, use a repo-root .env
# instead — see README.md.

GLM_API_KEY = "your_glm_key_here"
HUGGINGFACE_API_KEY = "your_huggingface_key_here"
