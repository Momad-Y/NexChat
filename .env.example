# Copy this file to .env at the repository root and fill in real values for
# local development. .env is gitignored — never commit your actual keys.
# For a deployed instance, set these same two keys in Streamlit's Secrets
# panel instead — see .streamlit/secrets.toml.example.

GLM_API_KEY=your_glm_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here
